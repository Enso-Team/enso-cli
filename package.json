{
  "name": "@enso-app/cli",
  "version": "0.9.2",
  "description": "Local command line interface for the Enso Mac app.",
  "type": "module",
  "bin": {
    "enso": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup src/index.ts --format esm --dts --clean --external @anthropic-ai/claude-agent-sdk",
    "dev": "tsx src/index.ts",
    "dev:install": "npm run build && npm link",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enso-Team/enso-cli.git"
  },
  "homepage": "https://github.com/Enso-Team/enso-cli#readme",
  "bugs": {
    "url": "https://github.com/Enso-Team/enso-cli/issues"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.318"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
