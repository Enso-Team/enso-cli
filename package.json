{
  "name": "@enso-app/cli",
  "version": "0.7.1",
  "description": "Local command line interface for the Enso Mac app.",
  "type": "module",
  "bin": {
    "enso": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "dev:install": "npm run build && npm link",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enso-Team/enso-cli.git"
  },
  "homepage": "https://github.com/Enso-Team/enso-cli#readme",
  "bugs": {
    "url": "https://github.com/Enso-Team/enso-cli/issues"
  }
}
