{
  "name": "@enso-app/cli",
  "version": "0.10.0",
  "description": "Local command line interface for the Enso Mac app.",
  "type": "module",
  "bin": {
    "enso": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "dev:install": "npm run build && npm link",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsup": "^9.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enso-Team/enso-cli.git"
  },
  "homepage": "https://ensocanvas.com",
  "bugs": {
    "url": "https://github.com/Enso-Team/enso-cli/issues"
  }
}
