{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@enso-app/core": [
        "./packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "packages/core/test"
  ]
}
